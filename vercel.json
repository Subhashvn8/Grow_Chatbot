{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pip install -r requirements-vercel.txt",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,data/raw/**,data/documents/**,data/chunks/**,data/embeddings/**,data/traces/**,.venv/**,**/__pycache__/**,**/*.pyc}"
    }
  }
}

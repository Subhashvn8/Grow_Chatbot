# Vercel environment variable template.
# Replace every CHANGE_ME value before importing. Do not commit real keys.

GROQ_API_KEY=CHANGE_ME_GROQ_API_KEY

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY

# For Chroma Cloud, use api.trychroma.com as the host.
# For self-hosted Chroma, use its hostname and default tenant/database if applicable.
CHROMA_HOST=CHANGE_ME_CHROMA_HOST
CHROMA_PORT=443
CHROMA_SSL=true
CHROMA_COLLECTION=hdfc_mf_facts
CHROMA_TENANT=CHANGE_ME_CHROMA_TENANT
CHROMA_DATABASE=CHANGE_ME_CHROMA_DATABASE
CHROMA_API_KEY=CHANGE_ME_CHROMA_API_KEY

TRACE_ENABLED=false

# Optional overrides
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=30
TOP_K=4

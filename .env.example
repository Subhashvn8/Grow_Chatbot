# Minimal Vercel environment variables.
# Replace every CHANGE_ME value before importing. Do not commit real keys.

# LLM secret. config.yaml already defaults to provider=groq and
# model=openai/gpt-oss-20b, so only the key is required.
GROQ_API_KEY=CHANGE_ME_GROQ_API_KEY

# Hosted embeddings are required on Vercel; local sentence-transformers
# cannot be bundled. The model must match the remote vector index.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY

# Remote Chroma. Local data/chroma is not available in a serverless function.
# For Chroma Cloud, host is api.trychroma.com and all four values are required.
CHROMA_HOST=CHANGE_ME_CHROMA_HOST
CHROMA_API_KEY=CHANGE_ME_CHROMA_API_KEY
CHROMA_TENANT=CHANGE_ME_CHROMA_TENANT
CHROMA_DATABASE=CHANGE_ME_CHROMA_DATABASE

# Optional overrides. Defaults already come from config.yaml / Settings:
# CHROMA_COLLECTION=hdfc_mf_facts
# CHROMA_PORT=443
# CHROMA_SSL=true
# TRACE_ENABLED=true (set false on Vercel to skip ephemeral trace writes)
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-20b
# LLM_TIMEOUT_SECONDS=30
# TOP_K=4
# VECTOR_METRIC=cosine
